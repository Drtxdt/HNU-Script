QWidget { font-family: "Microsoft YaHei UI", "Segoe UI"; font-size: 13px; color: #243247; }
QMainWindow, QWidget#workspace { background: #f4f7fb; }
QLabel#title { font-size: 25px; font-weight: 700; color: #152843; }
QLabel#subtitle { color: #64748b; }
QLabel#sectionTitle { font-weight: 600; color: #334155; padding: 4px 0; }
QLabel#formula { background: #eff6ff; color: #1e40af; border: 1px solid #dbeafe; border-radius: 6px; padding: 12px; font-size: 14px; }
QPlainTextEdit, QTreeWidget, QListWidget, QTableWidget, QGraphicsView { background: white; border: 1px solid #dce4ef; border-radius: 6px; selection-background-color: #dbeafe; selection-color: #172554; }
QPlainTextEdit { font-family: "Consolas", "Microsoft YaHei UI"; font-size: 15px; padding: 8px; }
QPushButton { background: white; border: 1px solid #cbd5e1; border-radius: 5px; padding: 6px 10px; }
QPushButton:hover { background: #eff6ff; border-color: #93c5fd; }
QPushButton:disabled { color: #a3afbf; background: #f1f5f9; }
QPushButton#primary { background: #2563eb; color: white; border: 1px solid #2563eb; font-weight: 600; }
QPushButton#primary:disabled { background: #94a3b8; border-color: #94a3b8; }
QComboBox { background: white; border: 1px solid #cbd5e1; border-radius: 5px; padding: 6px; min-height: 20px; }
QTabWidget::pane { border: 0; background: #f4f7fb; }
QTabBar::tab { padding: 10px 18px; color: #64748b; border-bottom: 3px solid transparent; }
QTabBar::tab:selected { color: #1d4ed8; font-weight: 600; border-bottom: 3px solid #2563eb; }
QHeaderView::section { background: #edf2f8; border: 0; padding: 7px; font-weight: 600; }
QSlider::groove:horizontal { background: #dce4ef; height: 5px; border-radius: 2px; }
QSlider::handle:horizontal { background: #2563eb; width: 13px; margin: -4px 0; border-radius: 6px; }
QStatusBar { background: #eaf0f8; color: #475569; }
