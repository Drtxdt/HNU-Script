      "enabled": true
    },
    {
      "name": "ASSIGN",
      "pattern": "'='",
      "category": "",
      "skip": false,
      "enabled": true
    },
    {
      "name": "SEMI",
      "pattern": "';'",
      "category": "",
      "skip": false,
      "enabled": true
    },
    {
      "name": "COMMENT",
      "pattern": "'//'[^\\r\\n]*",
      "category": "",
      "skip": true,
      "enabled": true
    },
    {
      "name": "WS",
      "pattern": "[ \\t\\r\\n]+",
      "category": "",
      "skip": true,
      "enabled": true
    }
  ],
