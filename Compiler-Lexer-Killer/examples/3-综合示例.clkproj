{
  "format_version": 1,
  "mode": "expression",
  "source": "(a|b)*abb",
  "input": "abababb",
  "definitions": "letter -> [A-Za-z_]\ndigit -> [0-9]\ndigits -> digit+",
  "rules": [
    {
      "name": "IF",
      "pattern": "'if'",
      "category": "reserved",
      "skip": false,
      "enabled": true
    },
    {
      "name": "INT",
      "pattern": "'int'",
      "category": "reserved",
      "skip": false,
      "enabled": true
    },
    {
      "name": "ID",
      "pattern": "letter(letter|digit)*",
      "category": "id",
      "skip": false,
      "enabled": true
    },
    {
      "name": "NUMBER",
      "pattern": "digits('.'digits)?('E'('+'|'-')?digits)?",
      "category": "number",
      "skip": false,
      "enabled": true
    },
    {
      "name": "LE",
      "pattern": "'<='",
