    "sql-formatter": "15.9.0",
    "elkjs": "0.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@vitejs/plugin-vue": "6.0.9",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vue-tsc": "3.3.11",
    "vitest": "4.1.11",
    "eslint": "9.39.5",
    "typescript-eslint": "8.71.0",
    "eslint-plugin-vue": "10.11.1",
